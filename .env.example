# OneStageROS の設定ファイル
# このファイルを .env という名前でコピーして編集してください:
#   cp .env.example .env
# .env は Git の管理対象外です（API キーなどを書くため、コミットしないでください）。
# 編集したあとは OneStageROS を再起動してください。

# ---------------------------------------------------------------
# ネットワーク公開
# ---------------------------------------------------------------
# false : このPC（localhost）からのみアクセスできます（既定）
# true  : 同じネットワーク上の他のPCや、Docker のホスト機からアクセスできます
#         Docker のコンテナ内で動かす場合は true にしてください
ONESTAGE_EXPOSE=false

# ---------------------------------------------------------------
# ワールド（任意）
# ---------------------------------------------------------------
# 起動時に読み込む .sdf / .world ファイル（ホームディレクトリからの相対パス、または絶対パス）
# ONESTAGE_WORLD=ros2_ws/src/my_pkg/worlds/room.world

# ロボットの初期位置 "x y yaw"（単位: m, m, rad）
# ONESTAGE_SPAWN=0.5 -1.0 1.57

# Gazebo モデル（model://）の検索パス。コロン区切りで複数指定できます
# GAZEBO_MODEL_PATH=/home/user/models

# ---------------------------------------------------------------
# AI 解析（任意）
# ---------------------------------------------------------------
# 画面の「AI解析 設定」から保存した値もここに書き込まれます
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=
# AI_SYSTEM_PROMPT=
